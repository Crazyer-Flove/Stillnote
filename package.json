{
  "name": "stillnote",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run build && electron desktop/main.cjs",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder --config electron-builder.yml --win --x64 --publish never",
    "desktop:unpacked": "npm run build && npm run desktop:prepare && electron-builder --config electron-builder.yml --win --x64 --dir --publish never"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "katex": "^0.18.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "description": "A quiet, local-first Markdown notebook for Windows and the web.",
  "author": "Crazyer-Flove",
  "license": "MIT",
  "homepage": "https://github.com/Crazyer-Flove/Stillnote",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crazyer-Flove/Stillnote.git"
  }
}
